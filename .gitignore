# ArborOS .gitignore

# ===== ISO & OS Build Artifacts =====
*.iso
*.img
*.squashfs
rootfs.img
mksquashfs-bin
build/output/
build/work/
build/iso/
livecd-temp/
livecd-work/
liveos-proper/
LiveOS-final/
Code/build/output/
Code/build/work/
Code/build/iso/

# ===== C++ / CMake / Qt Build Outputs =====
build/
**/build/
bin/
**/bin/
out/
**/out/
CMakeFiles/
**/CMakeFiles/
CMakeCache.txt
**/CMakeCache.txt
cmake_install.cmake
**/cmake_install.cmake
Makefile
**/Makefile
compile_commands.json
*.cmake.user
*.user
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb

# ===== Qt Generated Files =====
moc_*.cpp
ui_*.h
qrc_*.cpp
*.qrc.depends

# ===== Logs =====
*.log
*.log.*
build/*.log
Code/build/*.log

# ===== OS Generated Files =====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ===== Editor & IDE Files =====
*~
*.swp
*.swo
*.swn
.vscode/
.idea/
.vs/
*.sublime-*
.vim/

# ===== Temporary & Backup Files =====
*.tmp
*.temp
*.bak
*.backup
*.old

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
*.egg-info/

# ===== Archives =====
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.zip
*.rar
*.7z

# ===== Test & Coverage =====
test-results/
coverage/
.pytest_cache/

# ===== Secrets & Credentials =====
*.key
*.pem
*.p12
secrets.txt
.env
.env.*

# ===== Keep Essential Files =====
!.gitkeep
!README.md
!LICENSE

# ===== Internal Setup Files =====
.commit-plan.md
setup-git-history.bat
setup-*.bat
*.internal.md
