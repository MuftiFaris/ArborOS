{
  "app-id": "org.arboros.SoftwareCenter",
  "runtime": "org.kde.Platform",
  "runtime-version": "5.15",
  "sdk": "org.kde.Sdk",
  "command": "arbor-software-center",
  "rename-icon": "arbor-software-center",
  "copy-icon": true,
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--device=dri",
    "--share=network",
    "--system-talk-name=org.flatpak.Flatpak"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "*.a"
  ],
  "modules": [
    {
      "name": "arbor-design-system",
      "buildsystem": "cmake",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../../design-system"
        }
      ]
    },
    {
      "name": "arbor-software-center",
      "buildsystem": "cmake",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".."
        }
      ]
    }
  ]
}
